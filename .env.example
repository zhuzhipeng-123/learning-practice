# Copy this file to .env only on the target computer. Never commit the real file.
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
OPENROUTER_API_KEY=
# Optional absolute data directory. Default: project/data. Keep backups with this directory.
# LEARNING_DATA_DIR=C:/path/to/learning-data
# Optional IANA timezone used for day rollover and activity dates.
# LEARNING_TIMEZONE=Asia/Shanghai
# Optional source bootstrap file. Relative paths are resolved from the project root.
# LEARNING_SOURCE_CONFIG=local-config.sources.json
# Optional native executable override for Windows npm installations.
# LARK_CLI_PATH=C:/path/to/lark-cli.exe
